{
  "name": "moneygame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "typecheck:tests": "tsc --noEmit -p app/worker/tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "pnpm --filter @moneygame/web build && pnpm --filter @moneygame/worker exec wrangler d1 migrations apply moneygame --local && playwright test --config playwright.live.config.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "simulate:economy": "node --experimental-strip-types packages/game-core/src/spike-008/economy-cli.ts",
    "build": "pnpm --filter @moneygame/web build && pnpm --filter @moneygame/worker build",
    "simulate:production": "vitest run --config vitest.config.simulation.ts simulate-production",
    "fuzz:production": "vitest run --config vitest.config.simulation.ts fuzz-production",
    "simulate:seats": "vitest run --config vitest.config.simulation.ts seat-fairness",
    "simulate:reconciliation": "node --experimental-strip-types packages/game-core/src/spike-008/reconciliation-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.0.5"
  }
}
